        <div class="row">
            <input type="file" id="fileInput" accept=".log,.txt,.json,.jsonl,.ndjson,.csv,.tsv">
            <button id="btnFile" onclick="runCleaner('file')">파일로 실행</button>
        </div>
        <div class="hint">JSON, CSV, 일반 텍스트 로그(앱 로그·Nginx·Apache·syslog) 모두 가능 · 시간 정보가 있어야 함 · 최대 20MB</div>
    </div>

    <div class="section">
        <div class="section-title">2. 사이트 주소(URL)</div>
        <div class="row">
            <input type="text" id="urlInput" placeholder="https://example.com/app.log">
            <button id="btnUrl" onclick="runCleaner('url')">주소로 실행</button>
        </div>
        <div class="hint">http/https 주소만 가능하며 내부망 주소는 차단됩니다.</div>
    </div>

    <div class="section">
        <div class="section-title">3. 직접 붙여넣기 (JSON 또는 일반 텍스트)</div>
        <textarea id="logInput" placeholder='{"ts":"2026-11-09T10:00:00","level":"INFO","service":"auth","msg":"login ok"}'></textarea>
        <div class="row" style="margin-top:10px;">
            <button id="btnText" onclick="runCleaner('text')">입력한 로그로 실행</button>
            <button id="btnSample" onclick="runCleaner('sample')" class="secondary">샘플 데이터로 실행</button>
        </div>
    </div>

    <div class="row" style="justify-content:flex-end;">
        <label for="thInput" style="font-size: 13px; color: #4b5563;">임계값(Z):</label>
        <input id="thInput" type="number" value="3.5" step="0.5">
    </div>
    <div id="status"></div>
</div>

<div id="resultCard" class="card" style="display:none;">
    <h3 style="margin-top:0;">📊 실행 결과 요약</h3>
    <div class="metrics">
        <div class="metric-box"><div class="label">원본 로그</div><div id="mTotal" class="value">0</div></div>
        <div class="metric-box"><div class="label">정상 통과</div><div id="mOk" class="value" style="color: #16a34a;">0</div></div>
        <div class="metric-box"><div class="label">격리</div><div id="mQuarantine" class="value" style="color: #dc2626;">0</div></div>
        <div class="metric-box"><div class="label">마스킹</div><div id="mMasked" class="value" style="color: #2563eb;">0</div></div>
        <div class="metric-box"><div class="label">이상 구간</div><div id="mAnomalies" class="value" style="color: #d97706;">0</div></div>
    </div>
    <div id="detail" class="hint" style="margin-top:14px; font-size:13px;"></div>
    <div id="downloads" style="margin-top:16px;"></div>
    <h4 class="sub" id="segTitle" style="display:none;">🚨 이상 구간 (연속된 구간은 하나로 묶음)</h4>
    <div id="segWrap" style="overflow-x:auto;"></div>
    <details id="minWrap" style="margin-top:14px; display:none;">
        <summary style="cursor:pointer; font-size:13px; color:#475569;">분 단위 상세 보기</summary>
        <div id="anomalyWrap" style="overflow-x:auto; margin-top:8px;"></div>
    </details>
</div>

<script>
function setStatus(msg, isError) {
    var el = document.getElementById('status');
    el.textContent = msg || '';
    el.className = isError ? 'error' : '';
}

function setBusy(busy) {
    var ids = ['btnFile', 'btnUrl', 'btnText', 'btnSample'];
    for (var i = 0; i < ids.length; i++) {
        document.getElementById(ids[i]).disabled = busy;
    }
}

function mkTable(heads) {
    var table = document.createElement('table');
    table.className = 'at';
    var head = table.insertRow();
    for (var h = 0; h < heads.length; h++) {
        var th = document.createElement('th');
        th.textContent = heads[h];
        head.appendChild(th);
    }
    return table;
}

function renderDetail(data) {
    var d = document.getElementById('detail');
    var parts = ['임계값 ' + data.th + ' / 분석한 1분 구간 ' + data.bucket_count + '개 / 가장 큰 Z값 ' + data.max_z];
    var keys = Object.keys(data.stats || {});
    if (keys.length) {
        var s = [];
        for (var i = 0; i < keys.length; i++) { s.push(keys[i] + ' ' + data.stats[keys[i]] + '건'); }
        parts.push('격리 사유: ' + s.join(', '));
    }
    d.textContent = parts.join('  |  ');

    // 다운로드 버튼
    var dl = document.getElementById('downloads');
    dl.textContent = '';
    var counts = data.counts || {};
    var defs = [['clean', '정상 로그 (.jsonl)'], ['quarantine', '격리 로그 (.csv)'],
                ['segments', '이상 구간 요약 (.csv)'], ['anomaly_logs', '이상 구간 로그 (.jsonl)']];
    for (var x = 0; x < defs.length; x++) {
        var a = document.createElement('a');
        a.className = 'dl';
        a.href = '/download/' + data.token + '/' + defs[x][0];
        a.textContent = '⬇ ' + defs[x][1] + ' · ' + (counts[defs[x][0]] || 0) + '건';
        dl.appendChild(a);
    }

    // 이상 구간 (묶음)
    var segWrap = document.getElementById('segWrap');
    var segTitle = document.getElementById('segTitle');
    segWrap.textContent = '';
    var segs = data.segments || [];
    segTitle.style.display = 'block';
    if (!segs.length) {
        segWrap.textContent = '탐지된 이상 구간이 없습니다.';
    } else {
        var st = mkTable(['구간', '지속', '총 로그', '최대 로그/분', '최대 에러율(%)', '최대 건수 Z', '최대 에러율 Z', '사유', '주요 에러 메시지']);
        for (var j = 0; j < segs.length; j++) {
            var g = segs[j];
            var tr = st.insertRow();
            var range = (g.minutes > 1) ? (g.start + ' ~ ' + g.end) : g.start;
            var vals = [range, g.minutes + '분', g.total, g.peak, g.peak_err, g.max_zt, g.max_ze, g.reasons];
            for (var c = 0; c < vals.length; c++) { tr.insertCell().textContent = vals[c]; }
            var td = tr.insertCell();
            td.className = 'wrap';
            if (!g.top_errors.length) {
                td.textContent = '(에러 로그 없음)';
            } else {
                for (var e = 0; e < g.top_errors.length; e++) {
                    var line = document.createElement('div');
                    line.textContent = g.top_errors[e].count + '건  ' + g.top_errors[e].msg;
                    td.appendChild(line);
                }
            }
        }
        segWrap.appendChild(st);
    }

    // 분 단위 상세
    var wrap = document.getElementById('anomalyWrap');
    var minWrap = document.getElementById('minWrap');
    wrap.textContent = '';
    var rows = data.anomaly_rows || [];
    minWrap.style.display = rows.length ? 'block' : 'none';
    if (!rows.length) { return; }
    var table = mkTable(['시각', '로그 수', '에러율(%)', '건수 Z', '에러율 Z', '사유']);
    for (var k = 0; k < rows.length; k++) {
        var r = rows[k];
        var tr2 = table.insertRow();
        var v2 = [r.time, r.count, r.err, r.zt, r.ze, r.why];
        for (var m = 0; m < v2.length; m++) { tr2.insertCell().textContent = v2[m]; }
    }
    wrap.appendChild(table);
}

async function runCleaner(mode) {
    var fd = new FormData();
    fd.append('mode', mode);

    var th = parseFloat(document.getElementById('thInput').value);
    if (isNaN(th)) { th = 3.5; }
    fd.append('th', String(th));

    if (mode === 'file') {
        var f = document.getElementById('fileInput').files[0];
        if (!f) { setStatus('파일을 선택해주세요.', true); return; }
        fd.append('file', f);
    } else if (mode === 'url') {
        var u = document.getElementById('urlInput').value.trim();
        if (!u) { setStatus('주소를 입력해주세요.', true); return; }
        fd.append('url', u);
    } else if (mode === 'text') {
        var t = document.getElementById('logInput').value.trim();
        if (!t) { setStatus('로그 데이터를 입력해주세요.', true); return; }
        fd.append('text', t);
    }

    setBusy(true);
    setStatus('처리 중입니다...', false);

    try {
        var res = await fetch('/run', { method: 'POST', body: fd });
        var data = null;
        try {
            data = await res.json();
        } catch (e) {
            data = null;
        }
        if (!res.ok || !data || data.error) {
            var msg = (data && data.error) ? data.error : ('서버 오류 (' + res.status + ')');
            setStatus(msg, true);
            return;
        }

        document.getElementById('resultCard').style.display = 'block';
        document.getElementById('mTotal').textContent = data.total + '건';
        document.getElementById('mOk').textContent = data.ok_count + '건';
        document.getElementById('mQuarantine').textContent = data.quarantine_count + '건';
        document.getElementById('mMasked').textContent = data.masked_count + '건';
        document.getElementById('mAnomalies').textContent = data.anomalies + '개';
        renderDetail(data);
        setStatus('완료되었습니다.', false);
    } catch (e) {
        setStatus('서버에 연결하지 못했습니다: ' + e, true);
    } finally {
        setBusy(false);
    }
}
</script>
</body>
</html>
"""


@app.route("/")
def index():
    return INDEX_HTML


@app.errorhandler(413)
def too_large(_e):
    return jsonify({"error": "파일이 너무 큽니다 (20MB 초과)."}), 413


@app.route("/run", methods=["POST"])
def run_web():
    mode = request.form.get("mode", "sample")
    try:
        th = float(request.form.get("th", 3.5))
    except (TypeError, ValueError):
        th = 3.5

    try:
        if mode == "sample":
            lines = make_sample()
        elif mode == "file":
            f = request.files.get("file")
            if not f:
                return jsonify({"error": "파일을 선택해주세요."}), 400
            lines = decode_lines(f.read())
        elif mode == "url":
            url = request.form.get("url", "").strip()
            if not url:
                return jsonify({"error": "주소를 입력해주세요."}), 400
            lines = fetch_url(url)
        elif mode == "text":
            lines = decode_lines(request.form.get("text", "").encode("utf-8"))
        else:
            return jsonify({"error": "알 수 없는 입력 방식입니다."}), 400
    except ValueError as e:
        return jsonify({"error": str(e)}), 400

    if not lines:
        return jsonify({"error": "처리할 로그가 없습니다."}), 400

    ok, quarantine, stats, masked = clean_logs(lines)
    rows, med_t = volume(ok, th)

    anomaly_rows = [
        {
            "time": tlabel(r["k"]),
            "count": r["t"],
            "err": round(r["e"] * 100, 1),
            "zt": r["zt"],
            "ze": r["ze"],
            "why": ", ".join(r["why"]),
        }
        for r in rows if r["why"]
    ]
    max_z = max((max(abs(r["zt"]), r["ze"]) for r in rows), default=0.0)

    segs = build_segments(ok, rows)
    anomaly_mins = {r["k"] for r in rows if r["why"]}
    anomaly_logs = [r for r in ok if r["t"] // 60 in anomaly_mins]
    token = save_result({
        "ok": ok, "quarantine": quarantine, "segs": segs, "anomaly_logs": anomaly_logs,
    })

    return jsonify({
        "total": len(lines),
        "ok_count": len(ok),
        "quarantine_count": len(quarantine),
        "masked_count": masked,
        "anomalies": len(anomaly_rows),
        "anomaly_rows": anomaly_rows[:200],
        "segments": [{k: v for k, v in sg.items() if k not in ("k0", "k1")} for sg in segs[:100]],
        "bucket_count": len(rows),
        "max_z": round(max_z, 2),
        "th": th,
        "stats": {REASON.get(k, k): v for k, v in stats.items()},
        "token": token,
        "counts": {
            "clean": len(ok),
            "quarantine": len(quarantine),
            "segments": len(segs),
            "anomaly_logs": len(anomaly_logs),
        },
    })


@app.route("/download/<token>/<kind>")
def download(token, kind):
    res = RESULTS.get(token)
    if res is None:
        return "결과가 만료되었습니다. 다시 실행해 주세요.", 404

    if kind == "clean":
        body = "".join(json.dumps(r["rec"], ensure_ascii=False) + "\n" for r in res["ok"])
        name, ctype = "clean_logs.jsonl", "application/x-ndjson; charset=utf-8"
    elif kind == "anomaly_logs":
        body = "".join(json.dumps(r["rec"], ensure_ascii=False) + "\n" for r in res["anomaly_logs"])
        name, ctype = "anomaly_logs.jsonl", "application/x-ndjson; charset=utf-8"
    elif kind == "quarantine":
        body = to_csv(["사유", "원문"], [
            [REASON.get(q["reason"], q["reason"]), csv_safe(q["raw"])] for q in res["quarantine"]
        ])
        name, ctype = "quarantined_logs.csv", "text/csv; charset=utf-8"
    elif kind == "segments":
        body = to_csv(
            ["시작", "끝", "지속(분)", "총 로그", "최대 로그/분", "최대 에러율(%)",
             "최대 건수 Z", "최대 에러율 Z", "사유", "주요 에러 메시지"],
            [[sg["start"], sg["end"], sg["minutes"], sg["total"], sg["peak"], sg["peak_err"],
              sg["max_zt"], sg["max_ze"], csv_safe(sg["reasons"]),
              csv_safe(" | ".join("%d건 %s" % (e["count"], e["msg"]) for e in sg["top_errors"]))]
             for sg in res["segs"]],
        )
        name, ctype = "anomaly_segments.csv", "text/csv; charset=utf-8"
    else:
        return "알 수 없는 항목입니다.", 404

    return Response(body.encode("utf-8"), content_type=ctype,
                    headers={"Content-Disposition": 'attachment; filename="%s"' % name})


if __name__ == "__main__":
    app.run(debug=True, port=5000)
